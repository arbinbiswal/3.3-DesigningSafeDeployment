{
  "name": "orion-api",
  "version": "2.4.1",
  "description": "Orion Platform API Gateway",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit",
    "lint": "eslint src/**/*.js",
    "build": "node --check src/index.js && node --check src/routes.js && node --check src/controllers/userController.js && node --check src/controllers/orderController.js",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.0.3",
    "axios": "^1.4.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^6.3.3",
    "eslint": "^8.42.0",
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "braces": "^3.0.3",
    "sprintf-js": "^1.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 5000
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}
